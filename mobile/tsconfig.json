{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["react"],
    "baseUrl": ".",
    "paths": {
      // The shared core in ../src imports `zod`; it is installed here in
      // mobile/node_modules, not up the tree from ../src, so point tsc at it.
      "zod": ["./node_modules/zod"]
    }
  },
  "include": [
    "index.ts",
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../src/core/**/*.ts",
    "../src/model/**/*.ts",
    "../src/layout/**/*.ts",
    "../src/geometry/**/*.ts",
    "../src/data/**/*.ts",
    "../data/**/*.json"
  ],
  "exclude": ["node_modules", "../src/**/*.test.ts", "../src/**/*.test.tsx"]
}
